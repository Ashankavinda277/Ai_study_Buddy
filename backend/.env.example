# Copy to .env and fill in. Never commit the filled-in file.
#
# These values are for running the backend directly on your machine
# (uvicorn app.main:app --reload). When running under docker compose, the
# compose file overrides DATABASE_URL, CHROMA_HOST and CHROMA_PORT with the
# in-network service names -- everything else below is read from this file.

# --- Database ---
# Local Postgres from docker-compose:
DATABASE_URL=postgresql://studybuddy:studybuddy_pass@localhost:5432/study_buddy_db
# Hosted Postgres (e.g. Neon) needs SSL:
# DATABASE_URL=postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require

# --- Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- JWT / auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a DIFFERENT value in production -- anyone holding this can mint valid
# login cookies for any account.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local development over http: false.
# Any deployment served over https: true.
COOKIE_SECURE=false

# --- Vector store ---
# Host port from docker-compose (the container itself listens on 8000).
CHROMA_HOST=localhost
CHROMA_PORT=8001
