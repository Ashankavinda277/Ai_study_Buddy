# Copy to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, not
# read at runtime. Two consequences:
#
#   1. Changing this requires a rebuild, not just a restart.
#   2. In Docker it must be passed as a --build-arg (the compose file already
#      does this), because setting it at `docker run` time has no effect.
#
# This URL is fetched by the user's browser, so it has to be reachable from
# the browser. Under docker compose that means http://localhost:8000 -- not
# http://backend:8000, which only resolves inside the compose network.

NEXT_PUBLIC_API_URL=http://localhost:8000
